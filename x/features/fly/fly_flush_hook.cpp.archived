// MovePathFlushHook.dll — Phase B/C1: E9 hook MovePath.Flush (Classic TWMS)
// Inject with iDbg after GameAssembly is mapped (login OK; map recommended).
//
// Target: GameAssembly.dll + RVA 0x1198DC0  (MovePath_Flush)
// Prologue (IDA runtime): push rbp; push r15; push r14; ...  → steal=5
// ABI: rcx=this, rdx=OutPacket*, r8d=bFly, r9=oPath?, [stack]=MethodInfo*
//
// Out:
//   Dumps\runtime\movepath_flush.log
//   %TEMP%\xcat_movepath_flush.log
//   %TEMP%\xcat_movepath_flush_loaded.txt
//
// Env:
//   FLUSH_HOOK_SILENT=1     no MessageBox/Beep
//   FLUSH_FORCE_BFLY=1      always force r8d=1 (legacy Wings path only)
//   FLUSH_AUTO_BFLY=1       opt-in: forced/Attr16·17 → bFly (OFF by default since v1.3)
//   FLUSH_NO_AUTO_BFLY=1    (compat) same as default — no auto bFly
//   FLUSH_FIX_WINGS=0       disable Attr 16/17 → Normal rewrite (default ON)
//   FLUSH_BASELINE=1        jump/fall capture: NEVER force bFly; log Fh/all Attr
//   FLUSH_HOOK_RVA=0x...    override Flush RVA
//
// v1.1: auto force bFly when MovePath._forcedFlush or Attr in {16,17};
//       less aggressive FlushFileBuffers (main-thread stall risk).
// v1.2: FLUSH_BASELINE — dump Fh/FhFallStart/Elapse + all Elem Attr; no auto-bFly.
// v1.3: default NO auto-bFly; rewrite leftover Wings Attr→Normal (baseline air).

#define WIN32_LEAN_AND_MEAN
#include <Windows.h>
#include <Psapi.h>
#include <cstdarg>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#pragma comment(lib, "Psapi.lib")
#pragma comment(lib, "User32.lib")

namespace {

constexpr wchar_t kLogPrimary[] =
    L"C:\\Users\\kras\\Desktop\\xcat_for_TWMS\\Dumps\\runtime\\movepath_flush.log";
constexpr wchar_t kLogTemp[] = L"C:\\Users\\kras\\AppData\\Local\\Temp\\xcat_movepath_flush.log";
constexpr wchar_t kBeacon[] = L"C:\\Users\\kras\\AppData\\Local\\Temp\\xcat_movepath_flush_loaded.txt";
constexpr wchar_t kJsonPath[] =
    L"C:\\Users\\kras\\Desktop\\xcat_for_TWMS\\Dumps\\runtime\\movepath_flush.jsonl";

constexpr uint32_t kFlushRvaDefault = 0x1198DC0;
// push rbp (1) + push r15 (2) + push r14 (2) = 5; no RIP-relative
constexpr size_t kStealFlush = 5;

constexpr size_t kOffMpElem = 0x30;
constexpr size_t kOffMpForced = 0x48;
constexpr size_t kOffListItems = 0x10;
constexpr size_t kOffListSize = 0x18;
constexpr size_t kOffElemAttr = 0x10;
constexpr size_t kOffElemX = 0x12;
constexpr size_t kOffElemY = 0x14;
constexpr size_t kOffElemVx = 0x16;
constexpr size_t kOffElemVy = 0x18;
constexpr size_t kOffElemMoveAction = 0x1A;
constexpr size_t kOffElemFh = 0x1C;
constexpr size_t kOffElemFhFall = 0x1E;
constexpr size_t kOffElemElapse = 0x20;
constexpr size_t kOffElemStat = 0x22;
constexpr size_t kOffOutPacketId = 0x20;
constexpr int kMaxElemsSnap = 8;

HANDLE gLog = INVALID_HANDLE_VALUE;
HANDLE gLogTemp = INVALID_HANDLE_VALUE;
HANDLE gJson = INVALID_HANDLE_VALUE;
bool gSilent = false;
bool gForceBfly = false;
bool gAutoBfly = false;      // opt-in legacy; default OFF (v1.3)
bool gFixWings = true;       // Attr 16/17 → Normal before Flush
bool gBaseline = false;
uintptr_t gGaBase = 0;

void* gFlushTarget = nullptr;
uint8_t gFlushStolen[32]{};
void* gFlushTramp = nullptr;

using FnFlush = uint8_t (*)(void* self, void* outPacket, uint32_t bFly, void* oPath, void* methodInfo);
FnFlush gRealFlush = nullptr;

CRITICAL_SECTION gCs;
volatile LONG gHits = 0;
volatile LONG gLogged = 0;

void WriteAll(HANDLE h, const char* buf, int n) {
    if (h == INVALID_HANDLE_VALUE || n <= 0) return;
    DWORD w = 0;
    WriteFile(h, buf, (DWORD)n, &w, nullptr);
    // Avoid FlushFileBuffers on every line from game thread — can stall / stress GC.
}

void WriteAllFlush(HANDLE h, const char* buf, int n) {
    WriteAll(h, buf, n);
    if (h != INVALID_HANDLE_VALUE) FlushFileBuffers(h);
}

void Log(const char* fmt, ...) {
    char buf[2048];
    SYSTEMTIME st{};
    GetLocalTime(&st);
    int p = snprintf(buf, sizeof(buf), "[%02u:%02u:%02u.%03u] ", st.wHour, st.wMinute, st.wSecond,
                     st.wMilliseconds);
    if (p < 0) p = 0;
    va_list ap;
    va_start(ap, fmt);
    int n = vsnprintf(buf + p, sizeof(buf) - p, fmt, ap);
    va_end(ap);
    if (n < 0) return;
    n += p;
    if (n >= (int)sizeof(buf)) n = (int)sizeof(buf) - 1;
    buf[n++] = '\n';
    WriteAll(gLog, buf, n);
    WriteAll(gLogTemp, buf, n);
    OutputDebugStringA(buf);
}

void JsonLine(const char* fmt, ...) {
    char buf[1024];
    va_list ap;
    va_start(ap, fmt);
    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    if (n < 0) return;
    if (n >= (int)sizeof(buf)) n = (int)sizeof(buf) - 1;
    if (n == 0 || buf[n - 1] != '\n') {
        if (n < (int)sizeof(buf) - 1) buf[n++] = '\n';
    }
    WriteAll(gJson, buf, n);
}

bool EnvOn(const char* name) {
    char v[8]{};
    return GetEnvironmentVariableA(name, v, sizeof(v)) > 0 && v[0] == '1';
}

uint32_t EnvRva(const char* name, uint32_t defVal) {
    char v[32]{};
    if (GetEnvironmentVariableA(name, v, sizeof(v)) == 0) return defVal;
    return static_cast<uint32_t>(strtoul(v, nullptr, 0));
}

bool Rel32Fits(void* src, void* dst, size_t insnLen) {
    const intptr_t rel =
        reinterpret_cast<uint8_t*>(dst) - (reinterpret_cast<uint8_t*>(src) + static_cast<intptr_t>(insnLen));
    return rel == static_cast<int32_t>(rel);
}

void* AllocNear(void* target, size_t size) {
    SYSTEM_INFO si{};
    GetSystemInfo(&si);
    auto addr = reinterpret_cast<uintptr_t>(target);
    const uintptr_t span = 0x70000000ull;
    uintptr_t start = addr > span ? addr - span : 0;
    uintptr_t end = addr + span;
    for (uintptr_t a = start; a < end; a += si.dwAllocationGranularity) {
        void* p = VirtualAlloc(reinterpret_cast<void*>(a), size, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
        if (p) return p;
    }
    return nullptr;
}

bool WriteRel32Jmp(void* src, void* dst, size_t patchLen) {
    if (patchLen < 5 || patchLen > 32) return false;
    if (!Rel32Fits(src, dst, 5)) return false;
    uint8_t patch[32]{};
    patch[0] = 0xE9;
    const int32_t rel = static_cast<int32_t>(reinterpret_cast<uint8_t*>(dst) -
                                             (reinterpret_cast<uint8_t*>(src) + 5));
    memcpy(patch + 1, &rel, 4);
    for (size_t i = 5; i < patchLen; ++i) patch[i] = 0x90;
    DWORD old = 0;
    if (!VirtualProtect(src, (DWORD)patchLen, PAGE_EXECUTE_READWRITE, &old)) return false;
    memcpy(src, patch, patchLen);
    VirtualProtect(src, (DWORD)patchLen, old, &old);
    FlushInstructionCache(GetCurrentProcess(), src, patchLen);
    return true;
}

bool InstallRelHook(void* target, void* detour, size_t stealLen, uint8_t* stolenOut, void** trampOut,
                    void** realOut) {
    auto* tramp = static_cast<uint8_t*>(AllocNear(target, 64));
    if (!tramp) return false;
    if (!Rel32Fits(tramp + stealLen, static_cast<uint8_t*>(target) + stealLen, 5)) return false;

    memcpy(stolenOut, target, stealLen);
    memcpy(tramp, stolenOut, stealLen);
    tramp[stealLen] = 0xE9;
    {
        const int32_t rel = static_cast<int32_t>((reinterpret_cast<uint8_t*>(target) + stealLen) -
                                                 (tramp + stealLen + 5));
        memcpy(tramp + stealLen + 1, &rel, 4);
    }

    void* jmpTo = detour;
    if (!Rel32Fits(target, detour, 5)) {
        uint8_t* farStub = tramp + 32;
        farStub[0] = 0xFF;
        farStub[1] = 0x25;
        farStub[2] = 0x00;
        farStub[3] = 0x00;
        farStub[4] = 0x00;
        farStub[5] = 0x00;
        const uint64_t imm = reinterpret_cast<uint64_t>(detour);
        memcpy(farStub + 6, &imm, 8);
        jmpTo = farStub;
        if (!Rel32Fits(target, jmpTo, 5)) return false;
    }

    if (!WriteRel32Jmp(target, jmpTo, stealLen)) return false;
    *trampOut = tramp;
    *realOut = tramp;
    return true;
}

uintptr_t ModuleBase(const wchar_t* name) {
    HMODULE mods[512];
    DWORD needed = 0;
    if (!EnumProcessModules(GetCurrentProcess(), mods, sizeof(mods), &needed)) return 0;
    const DWORD n = needed / sizeof(HMODULE);
    wchar_t path[MAX_PATH];
    for (DWORD i = 0; i < n; ++i) {
        if (!GetModuleFileNameW(mods[i], path, MAX_PATH)) continue;
        const wchar_t* base = wcsrchr(path, L'\\');
        base = base ? base + 1 : path;
        if (_wcsicmp(base, name) == 0) return reinterpret_cast<uintptr_t>(mods[i]);
    }
    return 0;
}

struct OneElem {
    int attr;
    int x, y, vx, vy, moveAction;
    int fh, fhFall, elapse, stat;
};

struct ElemSnap {
    int size;
    int forced;
    int nSnap;
    OneElem e[kMaxElemsSnap];
};

const char* AttrName(int a) {
    switch (a) {
        case 0: return "Normal";
        case 1: return "Jump";
        case 2: return "Impact";
        case 3: return "Immediate";
        case 4: return "Teleport";
        case 6: return "FlashJump";
        case 10: return "StatChange";
        case 14: return "StartFalldown";
        case 15: return "FallDown";
        case 16: return "StartWings";
        case 17: return "Wings";
        case 18: return "VerticalJump";
        default: return "?";
    }
}

bool AttrInteresting(int a) {
    return a == 1 || a == 14 || a == 15 || a == 16 || a == 17 || a == 18 || a == 6;
}

int ReadElemSnapSeH(void* movePath, ElemSnap* out) {
    out->size = -1;
    out->forced = -1;
    out->nSnap = 0;
    memset(out->e, 0, sizeof(out->e));
    if (!movePath) return 0;
    __try {
        auto* mp = static_cast<uint8_t*>(movePath);
        out->forced = mp[kOffMpForced] ? 1 : 0;
        void* list = *reinterpret_cast<void**>(mp + kOffMpElem);
        if (!list) {
            out->size = 0;
            return 1;
        }
        auto* lp = static_cast<uint8_t*>(list);
        const int size = *reinterpret_cast<int*>(lp + kOffListSize);
        out->size = size;
        void* items = *reinterpret_cast<void**>(lp + kOffListItems);
        if (!items || size <= 0) return 1;
        // Il2CppArray: first element often at +0x20
        uint8_t* arr = static_cast<uint8_t*>(items);
        const int n = size < kMaxElemsSnap ? size : kMaxElemsSnap;
        for (int i = 0; i < n; ++i) {
            void* elem = *reinterpret_cast<void**>(arr + 0x20 + static_cast<size_t>(i) * 8);
            if (!elem) continue;
            auto* e = static_cast<uint8_t*>(elem);
            OneElem& o = out->e[out->nSnap++];
            o.attr = e[kOffElemAttr];
            o.x = *reinterpret_cast<int16_t*>(e + kOffElemX);
            o.y = *reinterpret_cast<int16_t*>(e + kOffElemY);
            o.vx = *reinterpret_cast<int16_t*>(e + kOffElemVx);
            o.vy = *reinterpret_cast<int16_t*>(e + kOffElemVy);
            o.moveAction = e[kOffElemMoveAction];
            o.fh = *reinterpret_cast<int16_t*>(e + kOffElemFh);
            o.fhFall = *reinterpret_cast<int16_t*>(e + kOffElemFhFall);
            o.elapse = *reinterpret_cast<int16_t*>(e + kOffElemElapse);
            o.stat = e[kOffElemStat];
        }
        return 1;
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return -1;
    }
}

int ReadPacketIdSeH(void* outPacket) {
    if (!outPacket) return -1;
    __try {
        return *reinterpret_cast<uint16_t*>(static_cast<uint8_t*>(outPacket) + kOffOutPacketId);
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return -2;
    }
}

bool SnapHasInteresting(const ElemSnap& snap) {
    for (int i = 0; i < snap.nSnap; ++i) {
        if (AttrInteresting(snap.e[i].attr)) return true;
        if (snap.e[i].vy <= -80 || snap.e[i].vy >= 80) return true;  // air vertical
        if (snap.e[i].fhFall != 0) return true;
    }
    return false;
}

bool ShouldLog(LONG hit, uint32_t bFly, const ElemSnap& snap) {
    if (gBaseline) {
        if (hit <= 500) return true;
        if (SnapHasInteresting(snap)) return true;
        return (hit % 10) == 0;
    }
    if (hit <= 200) return true;
    if (bFly) return true;
    if (SnapHasInteresting(snap)) return true;
    if (snap.forced == 1) return true;
    return (hit % 30) == 0;
}

void FormatElems(char* buf, int bufSz, const ElemSnap& snap) {
    int p = 0;
    for (int i = 0; i < snap.nSnap && p < bufSz - 8; ++i) {
        const OneElem& o = snap.e[i];
        const int n =
            snprintf(buf + p, bufSz - p,
                     " E%d[%s(%d) xy=(%d,%d) v=(%d,%d) ma=%d fh=%d fhFall=%d el=%d st=%d]", i,
                     AttrName(o.attr), o.attr, o.x, o.y, o.vx, o.vy, o.moveAction, o.fh, o.fhFall,
                     o.elapse, o.stat);
        if (n < 0) break;
        p += n;
    }
    if (p == 0 && bufSz > 0) buf[0] = 0;
}

int RewriteWingsElemsSeH(void* movePath) {
    if (!movePath || !gFixWings) return 0;
    int nFix = 0;
    __try {
        auto* mp = static_cast<uint8_t*>(movePath);
        void* list = *reinterpret_cast<void**>(mp + kOffMpElem);
        if (!list) return 0;
        auto* lp = static_cast<uint8_t*>(list);
        const int size = *reinterpret_cast<int*>(lp + kOffListSize);
        void* items = *reinterpret_cast<void**>(lp + kOffListItems);
        if (!items || size <= 0) return 0;
        uint8_t* arr = static_cast<uint8_t*>(items);
        const int n = size < 32 ? size : 32;
        for (int i = 0; i < n; ++i) {
            void* elem = *reinterpret_cast<void**>(arr + 0x20 + static_cast<size_t>(i) * 8);
            if (!elem) continue;
            auto* e = static_cast<uint8_t*>(elem);
            const int a = e[kOffElemAttr];
            if (a == 16 || a == 17) {
                e[kOffElemAttr] = 0;  // Normal — match baseline air
                ++nFix;
            }
        }
    } __except (EXCEPTION_EXECUTE_HANDLER) {
        return -1;
    }
    return nFix;
}

uint8_t Hook_Flush(void* self, void* outPacket, uint32_t bFly, void* oPath, void* methodInfo) {
    const LONG hit = InterlockedIncrement(&gHits);
    const uint32_t inBfly = bFly & 1u;
    uint32_t useBfly = inBfly;

    const int wingsFixed = RewriteWingsElemsSeH(self);

    ElemSnap snap{};
    ReadElemSnapSeH(self, &snap);
    const int pktId = ReadPacketIdSeH(outPacket);
    const int attr0 = snap.nSnap > 0 ? snap.e[0].attr : -1;

    // v1.3: never auto-raise bFly unless explicitly opted in (Wings path is wrong).
    const bool autoFly =
        !gBaseline && gAutoBfly && (snap.forced == 1 || attr0 == 16 || attr0 == 17);
    if (!gBaseline && (gForceBfly || autoFly)) useBfly = 1;
    if (gBaseline) useBfly = inBfly;

    if (ShouldLog(hit, useBfly, snap)) {
        InterlockedIncrement(&gLogged);
        char elems[1400];
        FormatElems(elems, (int)sizeof(elems), snap);
        const OneElem z{};
        const OneElem& e0 = snap.nSnap > 0 ? snap.e[0] : z;
        Log("FLUSH#%ld this=%p out=%p pktId=%d(0x%04X) bFly_in=%u bFly_use=%u oPath=%p "
            "forced=%d elemN=%d attr0=%d(%s) xy=(%d,%d) v=(%d,%d) ma=%d fh=%d fhFall=%d el=%d "
            "forceEnv=%d auto=%d base=%d fixW=%d%s",
            (long)hit, self, outPacket, pktId, pktId < 0 ? 0 : pktId, inBfly, useBfly, oPath,
            snap.forced, snap.size, attr0, AttrName(attr0), e0.x, e0.y, e0.vx, e0.vy, e0.moveAction,
            e0.fh, e0.fhFall, e0.elapse, gForceBfly ? 1 : 0, autoFly ? 1 : 0, gBaseline ? 1 : 0,
            wingsFixed, elems);
        JsonLine(
            "{\"n\":%ld,\"pktId\":%d,\"bFly_in\":%u,\"bFly_use\":%u,\"forced\":%d,\"elemN\":%d,"
            "\"attr0\":%d,\"x\":%d,\"y\":%d,\"vx\":%d,\"vy\":%d,\"ma\":%d,\"fh\":%d,\"fhFall\":%d,"
            "\"el\":%d,\"auto\":%d,\"base\":%d,\"fixW\":%d}",
            (long)hit, pktId, inBfly, useBfly, snap.forced, snap.size, attr0, e0.x, e0.y, e0.vx,
            e0.vy, e0.moveAction, e0.fh, e0.fhFall, e0.elapse, autoFly ? 1 : 0, gBaseline ? 1 : 0,
            wingsFixed);
    }

    return gRealFlush(self, outPacket, useBfly, oPath, methodInfo);
}

void OpenLogs() {
    if (gLog != INVALID_HANDLE_VALUE) return;
    gLog = CreateFileW(kLogPrimary, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS,
                       FILE_ATTRIBUTE_NORMAL, nullptr);
    gLogTemp = CreateFileW(kLogTemp, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS,
                           FILE_ATTRIBUTE_NORMAL, nullptr);
    gJson = CreateFileW(kJsonPath, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS,
                        FILE_ATTRIBUTE_NORMAL, nullptr);
    HANDLE beacon = CreateFileW(kBeacon, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_ALWAYS,
                                FILE_ATTRIBUTE_NORMAL, nullptr);
    if (beacon != INVALID_HANDLE_VALUE) {
        const char* msg = "MovePathFlushHook v1.3 loaded\n";
        DWORD w = 0;
        WriteFile(beacon, msg, (DWORD)strlen(msg), &w, nullptr);
        CloseHandle(beacon);
    }
}

bool InstallHooks() {
    gGaBase = ModuleBase(L"GameAssembly.dll");
    if (!gGaBase) {
        Log("ERR: GameAssembly.dll not found");
        return false;
    }
    const uint32_t rva = EnvRva("FLUSH_HOOK_RVA", kFlushRvaDefault);
    gFlushTarget = reinterpret_cast<void*>(gGaBase + rva);

    // Sanity: expect 55 41 57 41 56 (push rbp; push r15; push r14)
    const auto* p = static_cast<const uint8_t*>(gFlushTarget);
    Log("probe ga=0x%llX rva=0x%X target=%p bytes=%02X %02X %02X %02X %02X %02X %02X %02X",
        (unsigned long long)gGaBase, rva, gFlushTarget, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);

    if (!(p[0] == 0x55 && p[1] == 0x41 && p[2] == 0x57 && p[3] == 0x41 && p[4] == 0x56)) {
        Log("ERR: unexpected prologue (want 55 41 57 41 56). Refuse patch — wrong build or still encrypted?");
        return false;
    }

    void* real = nullptr;
    if (!InstallRelHook(gFlushTarget, reinterpret_cast<void*>(&Hook_Flush), kStealFlush, gFlushStolen,
                        &gFlushTramp, &real)) {
        Log("ERR: InstallRelHook failed");
        return false;
    }
    gRealFlush = reinterpret_cast<FnFlush>(real);
    Log("hooks OK patch=E9 steal=%zu tramp=%p real=%p forceBfly=%d", kStealFlush, gFlushTramp, gRealFlush,
        gForceBfly ? 1 : 0);
    return true;
}

DWORD WINAPI Worker(LPVOID) {
    OpenLogs();
    InitializeCriticalSection(&gCs);
    gSilent = EnvOn("FLUSH_HOOK_SILENT");
    gForceBfly = EnvOn("FLUSH_FORCE_BFLY");
    // v1.3 default: no auto bFly. Opt-in via FLUSH_AUTO_BFLY=1.
    gAutoBfly = EnvOn("FLUSH_AUTO_BFLY");
    gFixWings = true;
    {
        char buf[8]{};
        if (GetEnvironmentVariableA("FLUSH_FIX_WINGS", buf, sizeof(buf)) > 0)
            gFixWings = !(buf[0] == '0' && buf[1] == '\0');
    }
    gBaseline = EnvOn("FLUSH_BASELINE");
    if (gBaseline) {
        gAutoBfly = false;
        gForceBfly = false;
    }
    Log("MovePathFlushHook v1.3 starting forceBfly=%d autoBfly=%d fixWings=%d baseline=%d",
        gForceBfly ? 1 : 0, gAutoBfly ? 1 : 0, gFixWings ? 1 : 0, gBaseline ? 1 : 0);

    // Wait briefly for GameAssembly if injected early
    for (int i = 0; i < 100 && !ModuleBase(L"GameAssembly.dll"); ++i) Sleep(100);

    if (!InstallHooks()) {
        if (!gSilent) {
            MessageBoxW(nullptr, L"MovePathFlushHook: install failed — see movepath_flush.log",
                        L"MovePathFlushHook", MB_ICONERROR);
        }
        return 1;
    }

    if (!gSilent) {
        Beep(880, 80);
        Beep(1175, 80);
    }

    // Heartbeat while idle
    for (;;) {
        Sleep(5000);
        const LONG h = gHits;
        const LONG l = gLogged;
        if (h > 0) Log("heartbeat hits=%ld logged=%ld", (long)h, (long)l);
    }
    return 0;
}

}  // namespace

BOOL APIENTRY DllMain(HMODULE hModule, DWORD reason, LPVOID) {
    if (reason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(hModule);
        HANDLE t = CreateThread(nullptr, 0, Worker, nullptr, 0, nullptr);
        if (t) CloseHandle(t);
    }
    return TRUE;
}
